{
  "title": "Unified Document Search",
  "uid": "unified-document-search",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {"type":"stat","title":"Searches","datasource":"Prometheus","targets":[{"expr":"sum(document_search_total)","refId":"A"}],"gridPos":{"h":8,"w":6,"x":0,"y":0}},
    {"type":"stat","title":"Partial Results","datasource":"Prometheus","targets":[{"expr":"sum(document_search_partial_total)","refId":"A"}],"gridPos":{"h":8,"w":6,"x":6,"y":0}},
    {"type":"timeseries","title":"Search Duration (p95)","datasource":"Prometheus","targets":[{"expr":"histogram_quantile(0.95, sum(rate(document_search_duration_milliseconds_bucket[5m])) by (le))","refId":"A"}],"gridPos":{"h":8,"w":12,"x":12,"y":0}},
    {"type":"timeseries","title":"Provider Request Duration (p95)","datasource":"Prometheus","targets":[{"expr":"histogram_quantile(0.95, sum(rate(provider_request_duration_milliseconds_bucket[5m])) by (le,provider))","refId":"A","legendFormat":"{{provider}}"}],"gridPos":{"h":10,"w":12,"x":0,"y":8}},
    {"type":"timeseries","title":"Provider Failures","datasource":"Prometheus","targets":[{"expr":"sum(rate(provider_failure_total[5m])) by (provider,failure_type)","refId":"A","legendFormat":"{{provider}} {{failure_type}}"}],"gridPos":{"h":10,"w":12,"x":12,"y":8}}
  ]
}