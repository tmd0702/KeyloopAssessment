{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning",
      "Keyloop.UnifiedDocuments": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Keyloop.UnifiedDocuments": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "keyloop-unified-documents",
    "Audience": "keyloop-unified-documents-web"
  },
  "Search": {
    "OverallTimeoutSeconds": 12
  },
  "Audit": {
    "Enabled": false
  },
  "Providers": {
    "Sales": {
      "TimeoutSeconds": 6,
      "Concurrency": { "PermitLimit": 16, "QueueLimit": 16, "QueueTimeoutMilliseconds": 500 }
    },
    "Service": {
      "TimeoutSeconds": 10,
      "Concurrency": { "PermitLimit": 12, "QueueLimit": 12, "QueueTimeoutMilliseconds": 750 }
    }
  },
  "Caching": {
    "RedisConnection": "localhost:6379,abortConnect=false",
    "L1SizeLimitBytes": 67108864,
    "L1TtlSeconds": 30,
    "L2TtlSeconds": 120,
    "EmptyResultTtlSeconds": 30,
    "TtlJitterPercent": 10,
    "DistributedLock": {
      "Enabled": true,
      "LeaseSeconds": 30,
      "WaitSeconds": 10,
      "RetryDelayMilliseconds": 100
    }
  }
}
